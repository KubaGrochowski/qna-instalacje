{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "QNA Instalacje – podgląd WordPressa",
    "description": "WordPress z motywem QNA Instalacje i wtyczkami QNA (Zespół, Zdjęcia, Realizacje, Formularz, Opinie Google).",
    "author": "KubaGrochowski"
  },
  "landingPage": "/wp-admin/",
  "preferredVersions": { "php": "8.2", "wp": "latest" },
  "features": { "networking": true },
  "login": true,
  "steps": [
    { "step": "setSiteLanguage", "language": "pl_PL" },
    { "step": "setSiteOptions", "options": { "blogname": "QNA Instalacje", "blogdescription": "Instalacje, które działają", "timezone_string": "Europe/Warsaw", "blog_public": 0 } },
    { "step": "installTheme", "themeData": { "resource": "url", "url": "https://kubagrochowski.github.io/qna-instalacje/wp/qna-instalacje.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://kubagrochowski.github.io/qna-instalacje/wp/qna-zespol.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://kubagrochowski.github.io/qna-instalacje/wp/qna-realizacje.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://kubagrochowski.github.io/qna-instalacje/wp/qna-zdjecia.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://kubagrochowski.github.io/qna-instalacje/wp/qna-formularz.zip" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://kubagrochowski.github.io/qna-instalacje/wp/qna-opinie.zip" }, "options": { "activate": true } }
  ]
}
